{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-system.local/schemas/allocation_decision.json",
  "title": "AllocationDecision",
  "description": "Deterministic split of the campaign budget. Identical inputs must produce an identical decision. allocated + reserve must equal total_budget. Every figure is in 'currency', which is the currency the campaign TRADES in; where the operator's capital is held in another currency, total_budget is the converted equivalent and the declared original travels on the allocation run with the rate that produced it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allocation_id",
    "campaign_id",
    "as_of",
    "currency",
    "total_budget",
    "allocated",
    "reserve",
    "entries",
    "versions"
  ],
  "properties": {
    "allocation_id": { "type": "string", "minLength": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date-time" },
    "currency": {
      "description": "What every figure here is denominated in. Stated, never inferred from a field name.",
      "type": "string", "minLength": 3, "maxLength": 8
    },
    "total_budget": { "$ref": "#/$defs/money" },
    "allocated": { "$ref": "#/$defs/money" },
    "reserve": {
      "description": "Deliberately unallocated capital. A non-zero reserve is the normal outcome.",
      "$ref": "#/$defs/money"
    },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/allocation_entry" } },
    "versions": { "$ref": "#/$defs/system_versions" }
  },
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "allocation_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opportunity_id", "ticker", "rank", "opportunity_score", "allocated"],
      "properties": {
        "opportunity_id": { "type": "string", "minLength": 1 },
        "ticker": { "type": "string", "pattern": "^[A-Z0-9.\\-]+$" },
        "rank": { "type": "integer", "minimum": 1 },
        "opportunity_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "allocated": {
          "description": "Zero is valid and expected: a ranked opportunity need not be funded. In the parent decision's currency.",
          "$ref": "#/$defs/money"
        }
      }
    },
    "system_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "config_version"],
      "properties": {
        "application_version": { "type": "string", "minLength": 1 },
        "config_version": { "type": "string", "minLength": 1 },
        "strategy_spec_version": { "type": ["string", "null"] },
        "agent_version": { "type": ["string", "null"] },
        "model_id": { "type": ["string", "null"] },
        "data_source_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
