# ---------------------------------------------------------------------------
# Secrets — never commit. Only .env.example belongs in Git.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Runtime artifacts.
#
# Directory structure is tracked via .gitkeep; contents are not. Trade
# snapshots and market data are local research artifacts, not source code.
# ---------------------------------------------------------------------------
data/raw/*
data/normalized/*
data/cache/*
data/historical/*
data/snapshots/*
# Decision records: append-only local research artifacts, not source code.
data/universe/*
data/research/*
data/strategy/*
data/contracts/*
data/allocation/*
# The record of what was actually sent to a broker: broker order ids, fills and
# the account they belong to. Never committed.
data/execution/*
# Account snapshots additionally carry an account number and real balances.
# Nothing under data/ may ever be committed, and this one least of all.
data/accounts/*
# What the broker actually holds, what actually filled, where the campaign's
# money went, and every comparison between our records and the account. Real
# positions, real fills, a real account reference. Never committed.
data/positions/*
data/fills/*
data/reservations/*
data/reconciliation/*
# Exit management (Milestone 10) and the operational record (Milestone 11).
# Realised results are money; job runs, health reports and alerts name real
# positions and a real account. None of it is source code.
data/exit/*
data/pnl/*
data/operations/*
data/alerts/*
trades/open/*
trades/closed/*
trades/rejected/*
reports/daily/*
reports/weekly/*
reports/evaluation/*
logs/
*.db
*.sqlite3

!**/.gitkeep
