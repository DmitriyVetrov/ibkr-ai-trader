# ---------------------------------------------------------------------------
# Secrets — never commit. Only .env.example belongs in Git.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Runtime artifacts.
#
# Directory structure is tracked via .gitkeep; contents are not. Trade
# snapshots and market data are local research artifacts, not source code.
# ---------------------------------------------------------------------------
data/raw/*
data/normalized/*
data/cache/*
data/historical/*
data/snapshots/*
# Decision records: append-only local research artifacts, not source code.
data/universe/*
data/research/*
data/strategy/*
data/contracts/*
data/allocation/*
# Account snapshots additionally carry an account number and real balances.
# Nothing under data/ may ever be committed, and this one least of all.
data/accounts/*
trades/open/*
trades/closed/*
trades/rejected/*
reports/daily/*
reports/weekly/*
reports/evaluation/*
logs/
*.db
*.sqlite3

!**/.gitkeep
