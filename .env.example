# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. This file contains
# PLACEHOLDERS ONLY — never paste a real credential here.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Trading mode: DRY_RUN | PAPER | LIVE
#
# PAPER is the default and the only mode intended for the initial experiment.
# LIVE additionally requires every LIVE_* guard below to be set explicitly;
# setting TRADING_MODE=LIVE on its own is refused at startup.
# ---------------------------------------------------------------------------
TRADING_MODE=PAPER

# LIVE-mode guards. Leave false. See src/trading_system/infrastructure/settings.py.
LIVE_TRADING_CONFIRMED=false
LIVE_READINESS_CHECKLIST_SIGNED_OFF=false

# Test safety switch. Never set true in normal development: it unlocks tests
# that are capable of reaching a real broker account.
ALLOW_LIVE_TESTS=false

# The second, separate gate on the one test that SUBMITS A REAL PAPER ORDER
# (tests/integration/test_paper_execution.py). Both this and ALLOW_LIVE_TESTS
# must be true before it runs. Two variables rather than one on purpose: a
# developer who unlocked the gateway for a read-only diagnostic must not
# thereby have authorised an order.
RUN_PAPER_EXECUTION_TESTS=false

# ---------------------------------------------------------------------------
# IBKR connection (IB Gateway / IBC).
#
# Port reference — these four differ and are easy to confuse:
#
#   IB Gateway paper   4002   <- the project default
#   IB Gateway live    4001
#   TWS paper          7497
#   TWS live           7496
#
# Running in Docker Compose, the runtime reaches the gateway at
# IBKR_HOST=ib-gateway on internal port 4002; IBKR_PORT below is the HOST port.
# ---------------------------------------------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_USERNAME=your-ibkr-username
IBKR_PASSWORD=your-ibkr-password
IBKR_ACCOUNT=DU0000000

# Opens the IBKR API connection read-only, so IBKR itself rejects any order —
# the guarantee then does not depend on our own code being correct.
#
# Leave it true unless you deliberately intend to place paper orders. Setting it
# false does NOT by itself enable trading: `execution.enabled` in
# config/execution.yaml and an explicit `--confirm` on `execution run` are both
# still required, and every diagnostic keeps getting a read-only connection
# regardless of this value.
IBKR_READ_ONLY=true
IBKR_CONNECT_TIMEOUT_SECONDS=10

# Bound on every individual IBKR request. ib_async waits forever by default,
# and only the first uncached round trip on a connection is reliably answered,
# so an unbounded request is a real way to hang the process. Must be positive.
IBKR_REQUEST_TIMEOUT_SECONDS=30

# Market data type: 1 live, 2 frozen, 3 delayed, 4 delayed-frozen.
# Delayed needs no paid subscription and is honestly labelled as delayed.
IBKR_MARKET_DATA_TYPE=3

# Which broker implementation to use: IBKR or SIMULATOR.
# Leave unset to derive it from TRADING_MODE (DRY_RUN -> SIMULATOR).
# BROKER_BACKEND=SIMULATOR

# ---------------------------------------------------------------------------
# IB Gateway container (docker-compose.yml only)
# ---------------------------------------------------------------------------
IB_GATEWAY_IMAGE=ghcr.io/gnzsnz/ib-gateway:stable
# "paper" or "live" — a separate switch from TRADING_MODE on purpose.
IB_GATEWAY_MODE=paper
# Gateway-side order block, independent of the application's own guard.
IB_GATEWAY_READ_ONLY=yes
TZ=Etc/UTC

# ---------------------------------------------------------------------------
# Anthropic (AI agents). Used from Milestone 4 by the universe selector.
#
# Optional. Without it, `universe run` ends as AI_UNAVAILABLE and selects
# nothing — it does not fall back to an ordering of its own unless
# config/universe.yaml explicitly permits one. The model, prompt version and
# ranking policy live in config/universe.yaml; only the credential is here.
#
# `research run` behaves the same way and has no fallback at all: a universe can
# be ordered deterministically, but a market outlook cannot be, and anything
# synthesised in place of an unreachable model would be a fabricated view.
# Research policy lives in config/research.yaml.
#
# The test suite never needs this key: agent tests use deterministic fakes, and
# the live-model tests are skipped unless ALLOW_LIVE_TESTS=true.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Telegram notifications. Milestone 10.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=000000000

# ---------------------------------------------------------------------------
# Campaign budget. Overrides config/campaign.yaml when set.
# ---------------------------------------------------------------------------
CAMPAIGN_BUDGET_EUR=5000

# ---------------------------------------------------------------------------
# Persistence / logging
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/trading_system.db
LOG_LEVEL=INFO
LOG_FORMAT=console
